# Copiá este archivo a .env.local (desarrollo) o .env.production.local (servidor).
# Nunca lo subas a git con valores reales.

# --- Base de datos (PostgreSQL) ---
# La app entra como agenda2_app (sin permisos propios: cambia de rol en cada consulta).
# En desarrollo, `npm run db:local` levanta un Postgres en 127.0.0.1:54329 con estas claves.
DATABASE_URL=postgres://agenda2_app:agenda2_app_local@127.0.0.1:54329/agenda2
# Solo para `npm run db:migrar` (rol agenda2_dueno). En el servidor no va en el servicio de la app.
DATABASE_URL_MIGRAR=postgres://agenda2_dueno:agenda2_dueno_local@127.0.0.1:54329/agenda2

# --- Sesión (Better Auth) ---
# Secreto para firmar cookies y tokens (mínimo 32 caracteres). Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si cambia, se cierran todas las sesiones.
BETTER_AUTH_SECRET=
# URL pública de la app, sin "/" final (en producción: https://agenda2.tech).
BETTER_AUTH_URL=http://localhost:3000

# URL pública de la app (links de turnos, mails, accesos del equipo). Se fija al compilar.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Mail para pedidos sobre datos personales (se muestra en /privacidad).
NEXT_PUBLIC_CONTACTO_EMAIL=

# --- Mails (Resend) ---
# Sin estas variables los mails no se envían: en desarrollo se muestran enteros en la consola
# (ahí aparecen los links de verificación y de recuperación de contraseña).
RESEND_API_KEY=
# Remitente verificado en Resend, ej: "Agenda2 <turnos@agenda2.tech>"
EMAIL_FROM=
# Secreto para el cron de tareas (GET /api/cron con "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# --- Integraciones. Todas opcionales: sin ellas, la función se oculta. ---

# Clave para cifrar los tokens de Google y Mercado Pago que se guardan en la base.
# Mínimo 32 caracteres (mismo comando que arriba).
# Si la cambiás o la perdés, hay que volver a conectar las integraciones.
INTEGRACIONES_CLAVE=

# Google Calendar: credenciales OAuth (tipo "Aplicación web") de Google Cloud Console.
# URI de redirección autorizada: <NEXT_PUBLIC_SITE_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mercado Pago no necesita variables: cada negocio pega su Access Token en Panel → Integraciones.

# WhatsApp Cloud API (Meta). Opcional: sin esto, siguen funcionando los mensajes manuales (wa.me).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Nombres de las plantillas aprobadas en Meta (idioma es_AR, 5 parámetros: ver README).
WHATSAPP_PLANTILLA_CONFIRMACION=
WHATSAPP_PLANTILLA_RECORDATORIO=
