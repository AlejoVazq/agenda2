# Copiá este archivo a .env.local y completá con lo que imprime `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Se usa para invitar empleados (crear su usuario). NUNCA exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=
# URL pública de la app (para armar links de invitación y de turnos).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mails (Fase 4). Sin estas variables los mails no se envían (solo se registran en consola).
RESEND_API_KEY=
# Remitente verificado en Resend, ej: "Turnia <turnos@tudominio.com.ar>"
EMAIL_FROM=
# Secreto para el cron de recordatorios (GET /api/cron/recordatorios con "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=
