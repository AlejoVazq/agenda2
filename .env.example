# Copiá este archivo a .env.local y completá con lo que imprime `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Se usa para invitar empleados (crear su usuario). NUNCA exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=
# URL pública de la app (para armar links de invitación y de turnos).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
