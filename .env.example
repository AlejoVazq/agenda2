# Copiá este archivo a .env.local y completá con lo que imprime `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Se usa para invitar empleados (crear su usuario). NUNCA exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=
# URL pública de la app (para armar links de invitación y de turnos).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Mail para pedidos sobre datos personales (se muestra en /privacidad).
NEXT_PUBLIC_CONTACTO_EMAIL=

# Mails (Fase 4). Sin estas variables los mails no se envían (solo se registran en consola).
RESEND_API_KEY=
# Remitente verificado en Resend, ej: "Agenda2 <turnos@tudominio.com.ar>"
EMAIL_FROM=
# Secreto para el cron de tareas (GET /api/cron con "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# --- Integraciones (Fases 5 y 6). Todas opcionales: sin ellas, la función se oculta. ---

# Clave para cifrar los tokens de Google y Mercado Pago que se guardan en la base.
# Mínimo 32 caracteres. Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si la cambiás o la perdés, hay que volver a conectar las integraciones.
INTEGRACIONES_CLAVE=

# Google Calendar: credenciales OAuth (tipo "Aplicación web") de Google Cloud Console.
# URI de redirección autorizada: <NEXT_PUBLIC_SITE_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mercado Pago no necesita variables: cada negocio pega su Access Token en Panel → Integraciones.

# WhatsApp Cloud API (Meta). Opcional: sin esto, siguen funcionando los mensajes manuales (wa.me).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Nombres de las plantillas aprobadas en Meta (idioma es_AR, 5 parámetros: ver README).
WHATSAPP_PLANTILLA_CONFIRMACION=
WHATSAPP_PLANTILLA_RECORDATORIO=
