{
  "name": "agenda2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:db": "node scripts/test-db.mjs",
    "db:local": "node scripts/db-local.mjs",
    "db:migrar": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local --env-file-if-exists=.env.production.local scripts/migrar.mjs",
    "db:seed": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local scripts/seed.mjs",
    "db:reset": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local scripts/seed.mjs --reset"
  },
  "dependencies": {
    "@fullcalendar/react": "^7.1.3",
    "better-auth": "1.7.18",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "temporal-polyfill": "^1.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
